{
  "name": "olein/od-ai-content",
  "description": "Development tooling for the OD AI Content WordPress plugin.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "inc2734/wp-github-plugin-updater": "^3.1",
    "php": ">=7.4"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
    "wp-coding-standards/wpcs": "^3.4",
    "yoast/phpunit-polyfills": "^2.0.5"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "7.4.0"
    },
    "sort-packages": true
  },
  "scripts": {
    "i18n:verify": "php scripts/verify-translations.php",
    "lint": "phpcs",
    "format": "phpcbf",
    "package": "bash scripts/build-zip.sh",
    "package:verify": [
      "@package",
      "bash scripts/verify-zip.sh build/od-ai-content.zip",
      "bash scripts/check-reproducible-zip.sh"
    ]
  }
}
