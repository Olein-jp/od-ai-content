msgstr "文書のH1が投稿タイトルと一致しません。"

#: includes/class-diagnostics.php:452
msgid "The Markdown body contains content."
msgstr "Markdown本文にコンテンツがあります。"

#: includes/class-diagnostics.php:455
msgid "The Markdown body is empty."
msgstr "Markdown本文が空です。"

#: includes/class-diagnostics.php:458
msgid "The heading hierarchy has no level jumps."
msgstr "見出し階層にレベル飛びはありません。"

#. translators: %s: comma-separated heading level transitions, such as 2-4.
#: includes/class-diagnostics.php:463
#, php-format
msgid "The heading hierarchy contains level jumps: %s"
msgstr "見出し階層にレベル飛びがあります：%s"

#. translators: %s: comma-separated WordPress block names.
#: includes/class-diagnostics.php:470
#, php-format
msgid "Blocks excluded by the default conversion policy: %s"
msgstr "デフォルトの変換方針によって除外されたブロック：%s"

#. translators: %s: comma-separated WordPress block names.
#: includes/class-diagnostics.php:477
#, php-format
msgid "Blocks converted through the unverified HTML fallback: %s"
msgstr "未検証のHTMLフォールバックで変換されたブロック：%s"

#: includes/class-diagnostics.php:482
msgid "Unknown diagnostic result."
msgstr "不明な診断結果です。"

#: includes/class-editor-settings.php:75
