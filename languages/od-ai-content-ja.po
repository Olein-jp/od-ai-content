msgstr "Markdown文書を生成できませんでした。"

#: includes/class-diagnostics.php:430
msgid "Required front matter is present."
msgstr "必須のfront matterが含まれています。"

#. translators: %s: comma-separated metadata field names.
#: includes/class-diagnostics.php:435
#, php-format
msgid "Required front matter is missing: %s"
msgstr "必須のfront matterが不足しています：%s"

#: includes/class-diagnostics.php:440
